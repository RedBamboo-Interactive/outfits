{
  "schemaVersion": 1,
  "inputType": "outfits-extension-release-producer-input",
  "identity": {
    "id": "outfits",
    "version": "0.1.0"
  },
  "classification": "optional",
  "compatibility": {
    "kernelApi": "^0.1.0"
  },
  "toolchain": {
    "node": "22.23.1",
    "pnpm": "11.0.9",
    "dotnetSdk": "9.0.303",
    "msbuild": "17.14.13.31314"
  },
  "redleaf": {
    "repository": "RedBamboo-Interactive/redleaf",
    "commit": "4604a11ea2cb299a45fb0da8aa86dd0726164d50",
    "leafSdkPath": "src/Leaf.Sdk"
  },
  "redbamboo": {
    "repository": "RedBamboo-Interactive/redbamboo-packages",
    "commit": "5c238b3dff413a5448285ba4aa65e66a4dce634a",
    "lockPath": "pnpm-lock.yaml",
    "inputs": [
      {
        "id": "redbamboo-ui",
        "name": "@redbamboo/ui",
        "sourcePath": "packages/ui"
      },
      {
        "id": "redbamboo-utility",
        "name": "@redbamboo/utility",
        "sourcePath": "packages/utility"
      }
    ]
  },
  "build": {
    "backendProject": "src/Leaf.Plugins.Outfits/Leaf.Plugins.Outfits.csproj",
    "frontendDirectory": "web"
  },
  "locks": [
    {
      "id": "backend-nuget-lock",
      "ecosystem": "nuget",
      "path": "src/Leaf.Plugins.Outfits/packages.lock.json"
    },
    {
      "id": "redbamboo-pnpm-lock",
      "ecosystem": "npm",
      "path": "redbamboo-packages/pnpm-lock.yaml"
    },
    {
      "id": "tests-nuget-lock",
      "ecosystem": "nuget",
      "path": "tests/Leaf.Plugins.Outfits.Tests/packages.lock.json"
    },
    {
      "id": "web-pnpm-lock",
      "ecosystem": "npm",
      "path": "web/pnpm-lock.yaml"
    }
  ],
  "targetPlatform": {
    "operatingSystem": "windows",
    "architecture": "x64"
  },
  "dependencies": [],
  "runtimeRequirements": []
}
